# URL der Website, z. B. https://punktlandung.example.de
NEXT_PUBLIC_APP_URL=https://punktlandung.app
# CSP startet beobachtend. Erst nach Auswertung der Reports auf "enforce" stellen.
PUNKTLANDUNG_CSP_MODE=report-only
PUNKTLANDUNG_RELEASE=

# Nur fuer statische Netcup-Webhosting-Builds:
# true = Bilder direkt laden, ohne /api/image Proxy
NEXT_PUBLIC_DISABLE_IMAGE_PROXY=false

# AdSense ist technisch vorbereitet. Vor der öffentlichen Anzeigenlieferung
# Google-CMP veröffentlichen und die Website im AdSense-Konto freigeben lassen.
NEXT_PUBLIC_ADSENSE_ENABLED=true
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADS_REQUIRE_CONSENT=true
NEXT_PUBLIC_ADSENSE_TEST_MODE=false
# Offizielle, in AdSense unter "Privacy & messaging" veröffentlichte
# Ad-blocking-recovery-Mitteilung. Kein selbst gebauter Adblock-Detektor.
NEXT_PUBLIC_ADBLOCK_RECOVERY_ENABLED=false
NEXT_PUBLIC_ADBLOCK_RECOVERY_TAG_URL=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_LEFT_RAIL=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_RIGHT_RAIL=
NEXT_PUBLIC_ADSENSE_SLOT_SOLO_SETTINGS_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_PARTY_SETTINGS_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_ONLINE_SETTINGS_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_ONLINE_LEFT_RAIL=
NEXT_PUBLIC_ADSENSE_SLOT_ONLINE_RIGHT_RAIL=
NEXT_PUBLIC_ADSENSE_SLOT_LOBBY_LEFT_RAIL=
NEXT_PUBLIC_ADSENSE_SLOT_LOBBY_RIGHT_RAIL=
NEXT_PUBLIC_ADSENSE_SLOT_GAME_BOTTOM_LEFT=

# Google Analytics 4. Nur die oeffentliche Mess-ID (G-...), keine Zugangsdaten.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Accounts und gewertete Spiele bleiben deaktiviert, bis ein Backend-Anbieter
# im isolierten Entwicklungsprojekt abgenommen wurde.
ACCOUNT_BACKEND_PROVIDER=disabled
ACCOUNTS_ENABLED=false
RANKED_GAMES_ENABLED=false
GAME_SESSION_SECRET=
# Bei Rotation voruebergehend der alte Schluessel; nach spaetestens 72 Stunden entfernen.
GAME_SESSION_PREVIOUS_SECRET=

# Supabase-Kandidat. Nur verwenden, wenn ACCOUNT_BACKEND_PROVIDER=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Erst true setzen, nachdem der Google-Provider im Supabase-Dashboard konfiguriert ist.
SUPABASE_GOOGLE_LOGIN_ENABLED=false

# Firebase-Kandidat. Nur verwenden, wenn ACCOUNT_BACKEND_PROVIDER=firebase.
# Die NEXT_PUBLIC-Werte identifizieren die Web-App und sind keine Admin-Secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Feedback-Versand über Gmail. Für das Passwort ein Google-App-Passwort
# verwenden, niemals das normale Kontopasswort.
FEEDBACK_GMAIL_USER=aintartstudio@gmail.com
FEEDBACK_GMAIL_APP_PASSWORD=
FEEDBACK_TO_EMAIL=aintartstudio@gmail.com

# WebSocket-Server: Schutzgrenzen fuer die oeffentliche Beta.
# Spieler pro Raum bleiben produktseitig auf maximal 10 begrenzt.
WS_HOST=127.0.0.1
WS_PORT=3001
# Optional when the room server is not reachable locally from the Next.js process.
ROOM_SERVER_HEALTH_URL=
# Interne HTTP-Adresse des Raumservers für undurchsichtige Bild-Prefetches.
WS_INTERNAL_HTTP_URL=http://127.0.0.1:3001
WS_ALLOWED_ORIGINS=https://punktlandung.app,https://www.punktlandung.app
WS_MAX_PAYLOAD_BYTES=32768
WS_RATE_WINDOW_MS=10000
WS_RATE_LIMIT=80
WS_MAX_PLAYERS_PER_ROOM=10
WS_MAX_ACTIVE_ROOMS=1000
WS_MAX_CONNECTIONS=5000

# Anonyme Nutzungs- und Auslastungsereignisse fuer den Wochenbericht.
# Auf dem VPS einen dauerhaft beschreibbaren absoluten Pfad verwenden.
USAGE_METRICS_FILE=
USAGE_REPORT_TO_EMAIL=aintartstudio@gmail.com
