{
  "name": "punktlandung",
  "version": "1.0.0",
  "private": true,
  "description": "Punktlandung - kostenloses Geo-Quiz-Partyspiel mit Next.js und Leaflet.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "dev:full": "node scripts/dev.mjs",
    "next": "next dev -H 0.0.0.0 -p 3000",
    "ws": "tsx server/index.ts",
    "share:proxy": "tsx server/share-proxy.ts",
    "build": "next build",
    "build:check": "cross-env NEXT_DIST_DIR=.next-check next build",
    "build:static": "cross-env PUNKTLANDUNG_STATIC_EXPORT=true NEXT_PUBLIC_DISABLE_IMAGE_PROXY=true next build",
    "start": "next start -H localhost -p 3000",
    "catalog:generate": "node scripts/generate-wikimedia-catalog.mjs",
    "catalog:augment-images": "node scripts/augment-wikimedia-images.mjs",
    "licenses:generate": "tsx scripts/generate-image-licenses.ts",
    "boundaries:generate": "node scripts/generate-location-boundaries.mjs",
    "boundaries:fetch": "node scripts/generate-location-boundaries.mjs --fetch-osm",
    "check:responsive": "node scripts/responsive-check.mjs",
    "test:ws-hardening": "node scripts/ws-hardening-check.mjs",
    "test:image-delivery": "tsx scripts/check-image-delivery.ts",
    "report:usage": "tsx scripts/send-weekly-usage-report.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/node": "^20.17.12",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.4.20",
    "leaflet": "^1.9.4",
    "next": "^15.5.21",
    "nodemailer": "^9.0.3",
    "postcss": "^8.5.10",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "sharp": "^0.35.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "cross-env": "^7.0.3"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.0"
  }
}
