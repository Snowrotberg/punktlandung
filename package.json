{
  "name": "punktlandung",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Punktlandung - kostenloses Geo-Quiz-Partyspiel mit Next.js, MapLibre und Leaflet.",
  "scripts": {
    "dev": "cross-env NEXT_DIST_DIR=.next-dev-runtime next dev -H 0.0.0.0 -p 3000",
    "dev:full": "node scripts/dev.mjs",
    "next": "cross-env NEXT_DIST_DIR=.next-dev-runtime next dev -H 0.0.0.0 -p 3000",
    "ws": "tsx server/index.ts",
    "share:proxy": "tsx server/share-proxy.ts",
    "build": "next build && node scripts/generate-integrity-manifest.mjs",
    "build:check": "cross-env NEXT_DIST_DIR=.next-check next build",
    "build:static": "cross-env PUNKTLANDUNG_STATIC_EXPORT=true NEXT_PUBLIC_DISABLE_IMAGE_PROXY=true next build",
    "start": "next start -H localhost -p 3000",
    "catalog:generate": "node scripts/generate-wikimedia-catalog.mjs",
    "catalog:descriptions": "node scripts/enrich-wikidata-descriptions.mjs",
    "catalog:augment-images": "node scripts/augment-wikimedia-images.mjs",
    "catalog:audit": "tsx scripts/audit-location-catalog.ts",
    "catalog:audit-landscapes": "tsx scripts/audit-landscape-context.ts",
    "catalog:render-landscape-review": "tsx scripts/render-landscape-context-review.ts",
    "catalog:sample": "tsx scripts/render-catalog-quality-sample.mjs",
    "catalog:quarantine-images": "tsx scripts/quarantine-image-delivery.ts",
    "assets:optimize-ui": "node scripts/optimize-ui-images.mjs",
    "assets:social-preview": "node scripts/generate-social-preview.mjs",
    "licenses:generate": "tsx scripts/generate-image-licenses.ts",
    "boundaries:generate": "node scripts/generate-location-boundaries.mjs",
    "boundaries:fetch": "node scripts/generate-location-boundaries.mjs --fetch-osm",
    "check:responsive": "node scripts/responsive-check.mjs",
    "check:responsive:quick": "node scripts/responsive-check.mjs --profile=quick",
    "check:home-map-handoff": "node scripts/check-home-map-handoff.mjs",
    "check:globe-animation": "node scripts/check-globe-animation.mjs",
    "assets:home-map-posters": "node scripts/generate-home-map-posters.mjs",
    "test:domain": "node --import tsx --test tests/*.test.ts",
    "test:backend-prototypes": "node scripts/check-backend-prototypes.mjs",
    "test:supabase-migration": "node scripts/check-supabase-migration.mjs",
    "test:supabase-integration": "tsx --env-file=.env.local scripts/test-supabase-adapters.ts",
    "test:supabase-auth": "tsx --env-file=.env.local scripts/test-supabase-auth.ts",
    "test:backend-foundation": "npm run test:domain && npm run test:backend-prototypes && npm run typecheck && npm run test:ws-hardening",
    "check:provider-spike": "node scripts/check-provider-spike-prerequisites.mjs",
    "test:ws-hardening": "node scripts/ws-hardening-check.mjs",
    "test:image-delivery": "tsx scripts/check-image-delivery.ts",
    "test:game-modes": "node scripts/game-mode-e2e.mjs",
    "report:usage": "tsx scripts/send-weekly-usage-report.ts",
    "typecheck": "tsc --noEmit",
    "security:manifest": "node scripts/generate-integrity-manifest.mjs",
    "security:verify": "node scripts/verify-integrity-manifest.mjs",
    "security:monitor": "node scripts/security-monitor.mjs",
    "lint": "next lint"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.3",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^20.17.12",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.4.20",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.28.0",
    "maplibre-gl": "^5.24.0",
    "next": "^15.5.21",
    "nodemailer": "^9.0.3",
    "postcss": "^8.5.10",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "sharp": "^0.35.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "cross-env": "^7.0.3"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.0"
  }
}
